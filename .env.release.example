# Configuration of the packaged installation (compose.release.yml).
# scripts/landed.sh start (or landed.ps1) copies this to .env.release on first run and fills in
# a random password. Edit .env.release, never this file. .env.release is ignored by Git.
POSTGRES_USER=landed
POSTGRES_PASSWORD=generated-on-first-run
POSTGRES_DB=landed
# Host port; the app is reachable at http://127.0.0.1:<LANDED_PORT> from this computer only.
LANDED_PORT=3000

# Model access (optional). Leave every value empty to use paste-back mode only: the app builds the
# prompt, you run it in any assistant and paste the JSON answer back. The key stays in this file:
# never in the database, backups or logs. Run `sh scripts/landed.sh start` again after editing.
#
# Pick one block and fill it in. The model name is whatever the provider spells it as on its own
# model page.
#
#   OpenRouter (one key, models from many companies; key at https://openrouter.ai/settings/keys):
#     LANDED_MODEL_PROVIDER=openrouter
#     LANDED_MODEL=google/gemini-3.1-flash-lite
#     LANDED_MODEL_API_KEY=sk-or-...
#   Anthropic:
#     LANDED_MODEL_PROVIDER=anthropic
#     LANDED_MODEL=claude-sonnet-5
#     LANDED_MODEL_API_KEY=sk-ant-...
#   OpenAI:
#     LANDED_MODEL_PROVIDER=openai
#     LANDED_MODEL=gpt-5
#     LANDED_MODEL_API_KEY=sk-...
#   Vercel AI Gateway (one key, models addressed as company/model):
#     LANDED_MODEL_PROVIDER=gateway
#     LANDED_MODEL=anthropic/claude-sonnet-5
#     LANDED_MODEL_API_KEY=vck_...
#   Ollama or any other OpenAI-compatible server (base URL required, key optional). From inside
#   Docker a server on this computer is http://host.docker.internal:11434/v1, not localhost:
#     LANDED_MODEL_PROVIDER=openai_compatible
#     LANDED_MODEL=llama3.1
#     LANDED_MODEL_BASE_URL=http://host.docker.internal:11434/v1
LANDED_MODEL_PROVIDER=
LANDED_MODEL=
LANDED_MODEL_API_KEY=
LANDED_MODEL_BASE_URL=
