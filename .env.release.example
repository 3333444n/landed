# Configuration of the packaged installation (compose.release.yml).
# scripts/landed.sh start (or landed.ps1) copies this to .env.release on first run and fills in
# a random password. Edit .env.release, never this file. .env.release is ignored by Git.
POSTGRES_USER=landed
POSTGRES_PASSWORD=generated-on-first-run
POSTGRES_DB=landed
# Host port; the app is reachable at http://127.0.0.1:<LANDED_PORT> from this computer only.
LANDED_PORT=3000

# Model access (Phase 1b). Leave every value empty to use paste-back mode only: the app builds
# the prompt, you run it in any assistant and paste the JSON answer back. Restart with
# `sh scripts/landed.sh start` after editing these.
# Provider: anthropic | openai | gateway | openai_compatible
LANDED_MODEL_PROVIDER=
# Model name as the provider spells it, for example claude-opus-5 (anthropic), gpt-5 (openai),
# anthropic/claude-opus-5 (gateway), or the model served by an OpenAI-compatible endpoint.
LANDED_MODEL=
# The provider's API key. It stays in this file: never in the database, backups or logs.
LANDED_MODEL_API_KEY=
# Base URL for openai_compatible only. From inside Docker, a service on this computer is
# http://host.docker.internal:11434/v1 (Ollama), not localhost.
LANDED_MODEL_BASE_URL=
