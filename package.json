{
  "name": "landed",
  "version": "0.0.0",
  "private": true,
  "description": "Locally run job-search application: factual tailored materials and application tracking.",
  "license": "MIT",
  "packageManager": "pnpm@10.34.4",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "test:e2e": "playwright test",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node db/migrate.mjs",
    "db:backup": "node scripts/db-backup.mjs",
    "db:restore": "node scripts/db-restore.mjs",
    "import:postgres": "node scripts/import-postgres.mjs",
    "eval": "vitest run --project eval",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test && sh scripts/check-skill-sync.sh",
    "verify": "pnpm check && pnpm test:integration && sh scripts/check-migrations.sh",
    "verify:full": "pnpm verify && pnpm build && CI=true pnpm test:e2e"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "4.0.53",
    "@ai-sdk/openai": "4.0.66",
    "@ai-sdk/openai-compatible": "3.0.48",
    "@modelcontextprotocol/server": "2.0.0",
    "@react-pdf/renderer": "4.9.0",
    "@tiptap/pm": "3.31.3",
    "@tiptap/react": "3.31.3",
    "@tiptap/starter-kit": "3.31.3",
    "ai": "7.0.100",
    "drizzle-orm": "1.0.0-beta.22",
    "lucide-react": "1.46.0",
    "next": "16.3.5",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "4.6.4"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "2.0.0",
    "@playwright/test": "1.63.0",
    "@types/node": "^24.19.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "drizzle-kit": "1.0.0-beta.22",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.3.5",
    "pg": "8.23.0",
    "prettier": "3.9.6",
    "typescript": "5.9.3",
    "vitest": "^5.0.0"
  }
}
