# Copy to .env at the repository root for local development.
# The packaged release configures these automatically; contributors set them by hand.
DATABASE_URL=postgres://landed:landed@localhost:5432/landed
# Credentials used by docker-compose.yml for the development database.
POSTGRES_USER=landed
POSTGRES_PASSWORD=landed
POSTGRES_DB=landed

# Model access (optional). Leave every value empty to use paste-back mode only: the app builds the
# prompt, you run it in any assistant and paste the JSON answer back. Automated checks never need
# a key; tests use LANDED_MODEL_PROVIDER=fake (see .env.test.example). The key stays in this file:
# never committed, never stored in the database, never logged. Restart `pnpm dev` after editing.
#
# Pick one block and fill it in. The model name is whatever the provider spells it as on its own
# model page.
#
#   OpenRouter (one key, models from many companies; key at https://openrouter.ai/settings/keys):
#     LANDED_MODEL_PROVIDER=openrouter
#     LANDED_MODEL=google/gemini-3.1-flash-lite
#     LANDED_MODEL_API_KEY=sk-or-...
#   Anthropic:
#     LANDED_MODEL_PROVIDER=anthropic
#     LANDED_MODEL=claude-sonnet-5
#     LANDED_MODEL_API_KEY=sk-ant-...
#   OpenAI:
#     LANDED_MODEL_PROVIDER=openai
#     LANDED_MODEL=gpt-5
#     LANDED_MODEL_API_KEY=sk-...
#   Vercel AI Gateway (one key, models addressed as company/model):
#     LANDED_MODEL_PROVIDER=gateway
#     LANDED_MODEL=anthropic/claude-sonnet-5
#     LANDED_MODEL_API_KEY=vck_...
#   Ollama or any other OpenAI-compatible server (base URL required, key optional):
#     LANDED_MODEL_PROVIDER=openai_compatible
#     LANDED_MODEL=llama3.1
#     LANDED_MODEL_BASE_URL=http://localhost:11434/v1
LANDED_MODEL_PROVIDER=
LANDED_MODEL=
LANDED_MODEL_API_KEY=
LANDED_MODEL_BASE_URL=
# Where generated PDFs are written. Relative to the repository root.
LANDED_ARTIFACT_DIR=./artifacts
