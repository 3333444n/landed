# Copy to .env at the repository root for local development.
# The packaged release configures these automatically; contributors set them by hand.
DATABASE_URL=postgres://landed:landed@localhost:5432/landed
# Credentials used by docker-compose.yml for the development database.
POSTGRES_USER=landed
POSTGRES_PASSWORD=landed
POSTGRES_DB=landed

# Model access (Phase 1b). Leave every value empty to use paste-back mode only: the app builds
# the prompt, you run it in any assistant and paste the JSON answer back. Automated checks never
# need a key; tests use LANDED_MODEL_PROVIDER=fake (see .env.test.example).
# Provider: anthropic | openai | gateway | openai_compatible | fake
LANDED_MODEL_PROVIDER=
# Model name as the provider spells it, for example claude-opus-5 (anthropic), gpt-5 (openai),
# anthropic/claude-opus-5 (gateway), or the model served by an OpenAI-compatible endpoint.
LANDED_MODEL=
# The provider's API key. Never committed, never stored in the database, never logged.
LANDED_MODEL_API_KEY=
# Base URL for openai_compatible only, for example https://openrouter.ai/api/v1 or
# http://localhost:11434/v1 (Ollama). Ignored by the other providers.
LANDED_MODEL_BASE_URL=
# Where generated PDFs are written (Phase 1b). Relative to the repository root.
LANDED_ARTIFACT_DIR=./artifacts
